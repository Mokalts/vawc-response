# ───────────────────────────────────────────────
# VAWC-Response — .gitignore
# Keep secrets and build artifacts out of git
# ───────────────────────────────────────────────

# ── Environment files (CRITICAL — never commit) ──
.env
.env.*
!.env.example
**/.env
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local

# ── Backend (Python / FastAPI) ──
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
backend/venv/
backend/.venv/
backend/env/
backend/.pytest_cache/
backend/.mypy_cache/
backend/.ruff_cache/
backend/*.db
backend/*.sqlite3
backend/instance/

# ── Frontend (Node / React) ──
node_modules/
**/node_modules/
build/
**/build/
dist/
**/dist/
.cache/
**/.cache/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Uploads / generated content ──
backend/uploads/
# NOTE: admin-frontend/public/models/* (face-api models) ARE committed on purpose —
# they are required at runtime for admin face recognition and must ship with the build.

# ── IDE / editor metadata ──
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# ── OS junk ──
.DS_Store
Thumbs.db
desktop.ini

# ── Database dumps ──
*.dump
*.sql.gz

# ── Local override / secret notes ──
NOTES.md
SECRETS.md
TODO_PRIVATE.md
