# ─── VAWC-Response backend environment template ─────────────────────────────
# Copy this file to `.env` and fill in real values.
# NEVER commit the real .env to git — only this template.

# PostgreSQL
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@localhost:5432/vawc_response

# CORS — extra allowed frontend origins for production (comma-separated).
# localhost origins are always allowed. Example:
#   ALLOWED_ORIGINS=https://vawc-victim.web.app,https://vawc-admin.web.app
ALLOWED_ORIGINS=

# JWT (generate via: python -c "import secrets; print(secrets.token_urlsafe(64))")
SECRET_KEY=replace-with-a-strong-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Cloudinary (https://cloudinary.com — free tier sufficient)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# SMS provider — Semaphore PH (https://semaphore.co)
# SMS_API_KEY: your Semaphore API key (Account → API Keys).
# SMS_SENDER:  leave blank to use the default "SEMAPHORE" sender name,
#              or set a registered/approved custom sender name.
# If SMS_API_KEY is blank, OTP SMS is skipped and printed to the console (email OTP still works).
SMS_API_KEY=
SMS_SENDER=

# Gmail OTP (use a Google App Password, NOT your real Gmail password)
GMAIL_USER=your-gmail-address@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# Fernet encryption key for DB fields (statement, lat/lng, offender_name)
# Generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# AbstractAPI for email deliverability check (https://www.abstractapi.com/)
ABSTRACT_API_KEY=
